CHROMS = [f"chr{i}" for i in range(1, 20)] + ["chrX"]
RESOLUTION_BP = 250_000
RESOLUTION_LABEL = f"{RESOLUTION_BP // 1_000}kb"
PYTHON = "/Users/PSLabMonisha/miniforge3/envs/schiccluster/bin/python"
SCRIPT = "run_schiccluster_scptr.py"


rule all:
    input:
        expand(
            "results/{resolution}/{chrom}/schiccluster_results.txt",
            resolution=RESOLUTION_LABEL,
            chrom=CHROMS,
        ),
        expand(
            "results/{resolution}/{chrom}/schiccluster_clusters.tsv",
            resolution=RESOLUTION_LABEL,
            chrom=CHROMS,
        ),
        expand(
            "results/{resolution}/{chrom}/schiccluster_figure.png",
            resolution=RESOLUTION_LABEL,
            chrom=CHROMS,
        )


rule run_schiccluster_scptr:
    output:
        results="results/{resolution}/{chrom}/schiccluster_results.txt",
        clusters="results/{resolution}/{chrom}/schiccluster_clusters.tsv",
        figure="results/{resolution}/{chrom}/schiccluster_figure.png"
    params:
        resolution_bp=RESOLUTION_BP
    shell:
        "{PYTHON} {SCRIPT} "
        "--chrom {wildcards.chrom} "
        "--res {params.resolution_bp}"

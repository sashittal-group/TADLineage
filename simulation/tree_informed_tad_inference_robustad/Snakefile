# Tree-informed TAD inference at the LEAVES, with RobusTAD + the WEIGHTED ILP.
#
# The RobusTAD arm of ../tree_informed_tad_inference_ontad. Same claim (a caller misses
# real domains in a noisy leaf; its relatives are evidence it has them; imputing
# them back raises the leaf's F1, more so the noisier the Hi-C), same simulation,
# same seeds -- so a leaf's hidden truth is bit-identical across the two arms.
#
# What differs is what the solver knows about each call. RobusTAD scores every
# TAD it assembles AND every bin's left/right boundary propensity, including bins
# where it assembled nothing, so the weighted method can:
#   * pull confident leaf calls onto the parent (leaf_importance = {x, s, e}),
#   * charge each leaf a price for an imputed TAD discounted by ITS OWN boundary
#     evidence there (per-(node, interval) impute_cost), and
#   * place consensus boundaries by score, not just by sibling count.
# The unweighted `snap` method is run alongside as the control, so the figures
# separate "what the tree buys" from "what the scores buy".
#
# Two stages, each in its natural interpreter:
#   CALL  : RobusTAD on every leaf at every depth, cached          (cooler env)
#   SCORE : the imputation ILP + scoring vs truth                  (gurobi env)
# SCORE rebuilds the ground truth deterministically from the same seed, so both
# stages MUST get identical simulation params -- that is what COMMON is for.
#
# Run (from this directory):
#   snakemake --cores 8
# One region end to end:
#   snakemake --cores 4 results/tree00/region_000.json
#
# CALL is the expensive half: RobusTAD is ~8 s per leaf per depth, i.e. ~8 min
# per region for 10 leaves x 6 rungs. Start with a few trees (N_TREES below) and
# widen once the effect is confirmed; the calls are cached, so re-tuning the
# solver only re-runs SCORE.

# --- Replication ------------------------------------------------------------
# Trees and regions are pure replication axes; results are pooled over both.
# EVENTS_PER_EDGE is deliberately small: relatives have to actually share TADs
# for the tree to carry information.
N_NODES = 16                   # -> 9 to 11 leaves (10 random topologies)
N_TREES = 10
TREE_SEED = 20240101
TREES = [f"tree{i:02d}" for i in range(N_TREES)]

N_REGIONS = 20
REGIONS = list(range(N_REGIONS))

# --- Simulation (identical to the OnTAD arm) --------------------------------
N_BINS = 500
N_TOP_TADS = 10
NESTING_DEPTH = 2
MIN_SIZE = 8
MIN_SCORE_NODE_TADS = 6
EVENTS_PER_EDGE = 1
TOLERANCE = 2

# Base count density: A = A_REF * (bin_kb/REF_KB)^2 with A_REF=2000 at 40 kb puts
# 7.8 in the 2.5 kb regime. It has to be this count-poor for down-sampling to
# degrade the caller at all.
AMPLITUDE = 7.8

# --- RobusTAD ---------------------------------------------------------------
# minW is the one setting that moves the result: at 40 kb bins the default 80 kb
# (2 bins) window lets RobusTAD chase single-bin noise as the depth drops, and
# precision collapses. 160 kb (4 bins) is both more accurate and more stable
# across the ladder. alpha and maxW measurably do nothing here.
RT_MINW = 160
RT_MAXW = 2000
RT_RATIO = 1.2
RT_ALPHA = 0.05
RT_DELTA = 0.1
RT_MINTAD_BINS = 8
RT_MAXTAD_BINS = 200

# --- Imputation -------------------------------------------------------------
# impute_cost prices each interval a leaf gains. It MUST be > 0: the parsimony
# objective charges only for differences along edges, so adding an interval to a
# parent and all its children is free and the LP floods every leaf.
IMPUTE_COSTS = "0.5,0.75,1.5,3.0"
HEADLINE_COST = 0.5
# snap  = unweighted control (sibling count only) -- the OnTAD arm's method
# wsnap = everything RobusTAD's scores buy
# wimp / wpri are the ablations that separate the two weighting mechanisms;
# SCORE is seconds per region, so they are always on.
#
# All four are SCORED and land in the CSVs, but only PLOT_METHODS is DRAWN: the
# figures are the headline comparison (caller alone vs weighted tree-informed
# imputation) and nothing else. Set PLOT_METHODS = "all" to draw the control and
# the ablations too -- that also re-enables plots/weighting_gain.png, which needs
# the unweighted control to difference against and so must be added back to
# `rule all` and this rule's outputs.
METHODS = "snap,wsnap,wimp,wpri"
PLOT_METHODS = "wsnap"
HEADLINE_PREFIX = "wsnap"

# Scores are passed to leaf_importance as PERCENTILE RANKS within each leaf's own
# calls (see build_leaf_importance), which puts the leaf's median call exactly at
# the solver's indifference point. Fed raw, RobusTAD's scores sit almost entirely
# above that point and reward true and false calls alike -- measured neutral at
# w=0.1 and clearly harmful at w=0.3. Calibrated, w is flat over 0.1-0.3; 0.1 it
# is. The price discount below is what actually earns the gain.
IMPORTANCE_WEIGHT = 0.1
# How far a leaf's own boundary evidence moves the impute price around the flat
# one: best-supported candidate pays (1-d)*cost, worst pays (1+d)*cost, median
# pays exactly cost -- so the weighted method spends the SAME imputation budget
# as the unweighted control and only spends it in different places.
PRICE_DISCOUNT = 0.6
# Lower clamp, as a fraction of impute_cost. Imputation must never become free:
# the objective charges only for differences along edges, so a free interval on a
# parent and all its children costs nothing and the LP floods every leaf.
PRICE_FLOOR = 0.25

# --- Interpreters -----------------------------------------------------------
PYTHON_ROBUSTAD = "/Users/PSLabMonisha/miniforge3/envs/refhic/bin/python"            # cooler + RobusTAD
PYTHON_RECON = "/Users/PSLabMonisha/miniforge3/envs/snakemake-tutorial/bin/python"   # numpy + gurobipy
PYTHON_PLOT = PYTHON_RECON

CALLS = "calls"
RESULTS = "results"
PLOTS = "plots"

COMMON = (
    f"--n-nodes {N_NODES} --tree-seed {TREE_SEED} "
    f"--tolerance {TOLERANCE} --amplitude {AMPLITUDE} "
    f"--n-bins {N_BINS} --n-top-tads {N_TOP_TADS} --nesting-depth {NESTING_DEPTH} "
    f"--min-size {MIN_SIZE} --min-score-node-tads {MIN_SCORE_NODE_TADS} "
    f"--events-per-edge {EVENTS_PER_EDGE}"
)

RT_OPTS = (
    f"--rt-minW {RT_MINW} --rt-maxW {RT_MAXW} --rt-ratio {RT_RATIO} "
    f"--rt-alpha {RT_ALPHA} --rt-delta {RT_DELTA} "
    f"--rt-mintad-bins {RT_MINTAD_BINS} --rt-maxtad-bins {RT_MAXTAD_BINS}"
)


wildcard_constraints:
    idx=r"\d+",
    tree=r"tree\d+"


rule all:
    input:
        expand(RESULTS + "/{tree}/region_{idx:03d}.json", tree=TREES, idx=REGIONS),
        PLOTS + "/f1_vs_noise.png",
        PLOTS + "/f1_vs_noise_by_cost.png",
        PLOTS + "/impute_gain.png",
        PLOTS + "/leaf_metrics_long.csv",
        PLOTS + "/leaf_metrics_summary.csv"


rule call_robustad:
    output:
        CALLS + "/{tree}/region_{idx}.json"
    log:
        "logs/call_{tree}_region_{idx}.log"
    shell:
        "{PYTHON_ROBUSTAD} run_tree_impute_rt.py --tree {wildcards.tree} "
        "--region-index {wildcards.idx} --stage call "
        "--outdir {CALLS}/{wildcards.tree} "
        + RT_OPTS + " " + COMMON + " > {log} 2>&1"


rule score:
    input:
        calls=CALLS + "/{tree}/region_{idx}.json"
    output:
        RESULTS + "/{tree}/region_{idx}.json"
    log:
        "logs/score_{tree}_region_{idx}.log"
    shell:
        "{PYTHON_RECON} run_tree_impute_rt.py --tree {wildcards.tree} "
        "--region-index {wildcards.idx} --stage score "
        "--calls-json {input.calls} "
        "--impute-costs {IMPUTE_COSTS} --methods {METHODS} "
        "--headline-cost {HEADLINE_COST} --headline-prefix {HEADLINE_PREFIX} "
        "--importance-weight {IMPORTANCE_WEIGHT} "
        "--price-discount {PRICE_DISCOUNT} --price-floor {PRICE_FLOOR} "
        "--outdir {RESULTS}/{wildcards.tree} "
        + COMMON + " > {log} 2>&1"


rule plot:
    input:
        expand(RESULTS + "/{tree}/region_{idx:03d}.json", tree=TREES, idx=REGIONS)
    output:
        headline=PLOTS + "/f1_vs_noise.png",
        by_cost=PLOTS + "/f1_vs_noise_by_cost.png",
        gain=PLOTS + "/impute_gain.png",
        long_csv=PLOTS + "/leaf_metrics_long.csv",
        summary_csv=PLOTS + "/leaf_metrics_summary.csv"
    log:
        "logs/plot.log"
    shell:
        "{PYTHON_PLOT} plot_tree_impute_rt.py --results-dir {RESULTS} --outdir {PLOTS} "
        "--headline-cost {HEADLINE_COST} --headline-prefix {HEADLINE_PREFIX} "
        "--plot-methods {PLOT_METHODS} "
        "> {log} 2>&1"
